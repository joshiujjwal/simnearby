# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.

# Database
DATABASE_URL=postgres://simnearby:password@localhost:5432/simnearby

# Object Store (S3-compatible — use MinIO for local dev)
S3_BUCKET=simnearby-assets
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Server
PORT=3001
NODE_ENV=development

# Reconstruction worker
RECONSTRUCTION_QUEUE_URL=redis://localhost:6379
COLMAP_BIN=/usr/local/bin/colmap
GPU_ENABLED=false
